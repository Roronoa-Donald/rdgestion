# =========================
# RDGESTION — Configuration
# =========================

# Base de données PostgreSQL
DATABASE_URL=postgresql://rdgestion_user:mot_de_passe@localhost:5432/rdgestion_db

# JWT
# IMPORTANT : générez une clé secrète aléatoire d'au moins 32 caractères.
#   Ex: openssl rand -hex 32   (Linux/macOS) ou 32+ caractères aléatoires.
# N'utilisez PAS un placeholder comme "votre_secret...", "change_moi",
# "ultra_securise" — la validation en production refusera le démarrage.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Serveur
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:8080

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10

# Uploads
UPLOAD_MAX_SIZE=2097152
UPLOAD_DIR=./uploads

# Super Admin (créé au premier lancement)
SUPERADMIN_PHONE=+22890000000
SUPERADMIN_PASSWORD=SuperAdmin123!
